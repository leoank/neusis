# Dendritic wiring for this flake.
#
# `flake-file` regenerates ../flake.nix from the `flake-file.inputs`
# declared here (and in any other module). `import-tree ./modules`
# auto-imports every module under modules/, so new files are picked up
# without editing an imports list.
#
# After changing inputs here, run `nix run .#write-flake` to regenerate
# flake.nix. (Remember to `git add` new files first — nix ignores
# untracked files.)
{ inputs, ... }:
{
  imports = [
    inputs.flake-file.flakeModules.dendritic
    # neusis library: `flake.neusis.*` option schema, `neusisOS`
    # builders (mkNeusisFlake, mkNeusisOS, …), and the agnostic
    # integration modules (hm-system-init, secrets) the builders
    # consume via `self.{nixos,darwin}Modules.*`.
    inputs.neusis.flakeModules.default
  ];

  flake-file.inputs = {
    agenix = {
      url = "github:ryantm/agenix";
      inputs.nixpkgs.follows = "nixpkgs";
    };
    agenix-rekey = {
      url = "github:oddlama/agenix-rekey";
      inputs.nixpkgs.follows = "nixpkgs";
    };
{{- if .IncludeDarwin }}
    darwin = {
      url = {{ .DarwinRef | nixStr }};
      inputs.nixpkgs.follows = "nixpkgs";
    };
{{- end }}
    flake-file.url = "github:vic/flake-file";
    flake-parts = {
      url = "github:hercules-ci/flake-parts";
      inputs.nixpkgs-lib.follows = "nixpkgs";
    };
    home-manager = {
      url = {{ .HMRef | nixStr }};
      inputs.nixpkgs.follows = "nixpkgs";
    };
    import-tree.url = "github:vic/import-tree";
    neusis.url = {{ .NeusisRef | nixStr }};
    nixpkgs.url = {{ .NixpkgsRef | nixStr }};
  };

  flake-file.outputs = ''
    inputs: inputs.flake-parts.lib.mkFlake { inherit inputs; } (inputs.import-tree ./modules)
  '';
}
