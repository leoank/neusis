      config,
      lib,
      pkgs,
      ...
    }:
    {
      # nix-darwin feature bundle settings
    };
{{- else if eq .Type "nixos" }}
  flake.neusis.features.nixos.{{ .Name }} =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    {
      # NixOS feature bundle settings
    };
{{- else }}
  flake.neusis.features.agnostic.{{ .Name }} =
    {
      config,
      lib,
      pkgs,
      ...
    }:
