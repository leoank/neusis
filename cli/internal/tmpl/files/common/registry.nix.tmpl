# Registry {{ .Name | nixStr }} — machine, user, and builders registries.
#
# Machines, users, and remote builders register *themselves* into these
# lists from their own files under `modules/` (module lists merge across
# files). This file only declares the registry with empty lists so the
# attributes always exist — even before anything joins them.
{ ... }:
{
  flake.neusis.registry.machines.{{ .Name }} = {
    nixos = [ ];
    darwin = [ ];
  };

  flake.neusis.registry.users.{{ .Name }} = {
    admins = [ ];
    regulars = [ ];
    guests = [ ];
    locked = [ ];
  };

  flake.neusis.registry.builders.{{ .Name }} = [ ];
}
